# Required for stable signed login sessions in production
SESSION_SECRET=replace-with-a-long-random-secret

# Optional but strongly recommended for durable Vercel data storage.
# Create an Upstash Redis database and copy its REST URL + REST token.
KV_REST_API_URL=https://your-upstash-database.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token

# Local development only (default is 3000)
PORT=3000
